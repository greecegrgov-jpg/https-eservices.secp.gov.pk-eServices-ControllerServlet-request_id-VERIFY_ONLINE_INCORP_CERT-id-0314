function isInValid(inputValue)
{
	var Val=inputValue;

	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);

		if((ch == ' ')||(ch=='.')||(ch=='!')||(ch=='@')||(ch=='#')||(ch=='$') || (ch == '%')||(ch=='^')||(ch=='&')||(ch=='*')||(ch=='_'))
		{
			return true;
		}
	}

	return false;
}

//checks that value is integer or float(upto 9 decimel places)
function isDollarUpto9Decimal(fieldValue) {
	decallowed = 9;  // how many decimals are allowed?
	
	if (isNaN(fieldValue) ) {
		return false;
	}
	else if( trim(fieldValue) == "" && fieldValue.length>0){	
		return false;		
	}
	else {
		if (fieldValue.indexOf('.') == -1) 
			fieldValue += ".";		
		dectext = fieldValue.substring(fieldValue.indexOf('.')+1, fieldValue.length);
		if (dectext.length > decallowed){
		
			return false;
	    	}
   	}	
   return true;
}

function isDecimal(value) {
	
	var re =/^(-{0,1})\d*(\.\d{1,15})?$/;

	if(re.test(value) != true) {
		return false;
	}
	return true;

}


function isValidDateWithFormat( strValue ) {
/************************************************
DESCRIPTION: Validates that a string contains only
    valid dates with 2 digit month, 2 digit day,
    4 digit year. Date separator can be ., -, or /.
    Uses combination of regular expressions and
    string parsing to validate date.
    Ex. mm/dd/yyyy or mm-dd-yyyy or mm.dd.yyyy

PARAMETERS:
   strValue - String to be tested for validity

RETURNS:
   True if valid, otherwise false.

REMARKS:
   Avoids some of the limitations of the Date.parse()
   method such as the date separator character.
*************************************************/
  var objRegExp = /^\d{2}(\/)\d{2}(\/)\d{4}$/
 
  //check to see if in correct format
  if(!objRegExp.test(strValue))
    return false; //doesn't match pattern, bad date
  else{
    var strSeparator = strValue.substring(2,3) 
    var arrayDate = strValue.split(strSeparator); 
    //create a lookup for months not equal to Feb.
    var arrayLookup = { '01' : 31,'03' : 31, 
                        '04' : 30,'05' : 31,
                        '06' : 30,'07' : 31,
                        '08' : 31,'09' : 30,
                        '10' : 31,'11' : 30,'12' : 31}
    var intDay = parseInt(arrayDate[0],10); 

    //check if month value and day value agree
    if(arrayLookup[arrayDate[1]] != null) {
      if(intDay <= arrayLookup[arrayDate[1]] && intDay != 0)
        return true; //found in lookup table, good date
    }
    
    //check for February (bugfix 20050322)
    //bugfix  for parseInt kevin
    //bugfix  biss year  O.Jp Voutat
    var intMonth = parseInt(arrayDate[1],10);
    if (intMonth == 2) { 
       var intYear = parseInt(arrayDate[2]);
       if (intDay > 0 && intDay < 29) {
           return true;
       }
       else if (intDay == 29) {
         if ((intYear % 4 == 0) && (intYear % 100 != 0) || 
             (intYear % 400 == 0)) {
              // year div by 4 and ((not div by 100) or div by 400) ->ok
             return true;
         }   
       }
    }
  }  
  return false; //any other values, bad date
}




function validateGridCell(grid, columnIndex, criteria, cellName) {
	var rowIndex=0;
	var lastRow =grid.object.rowCount();
	
	var filters = criteria.split(",");
	var required = filters[0].split("=");
	var input = filters[1].split("=");
	var length = filters[2].split("=");
	
	while(rowIndex<lastRow) {
		//required
		
		if(trim(required[1])=="true") {
			if (trim(grid.object.getCellText(rowIndex, columnIndex)) == "") {
				//alert("Input required for "+ cellName +" at row: "+ ++rowIndex);
				ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Input Required");
				return false;
			}
		}
		
		if(trim(grid.object.getCellText(rowIndex, columnIndex))!= "") {
			//type
			//if(trim(input[1])=="allowAll") {
			//	return true;
			//}
			if(trim(input[1])=="decimal") {
				if (!isDecimal(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric or decimal values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only numeric or decimal values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="gridText") {
				if (!isValidTextForGrid(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Only alpha-Numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only alpha-Numeric values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="number") {
				if (!isNumberValid(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only integer values are allowed (No Decimal)");
					return false;
				}
			}
			else if(trim(input[1])=="date") {
				if (!isValidDateWithFormat(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Date is not valid for "+ cellName +" at row: "+ ++rowIndex +" \nDate Format is DD/MM/YYYY");
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Date is not valid. \nDate Format is DD/MM/YYYY");
					return false;
				}
			}
			
			//if decimal or number value, remove comma(,) and then check length
			if(trim(input[1])=="decimal" || trim(input[1])=="number") {
				//length
				if (grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,"").length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
			else {
				//length
				if (grid.object.getCellText(rowIndex, columnIndex).length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
		}
		rowIndex++;
	}
	return true;
}

function validateGridCell1(grid, columnIndex, rowIndex, criteria, cellName) {
	//var rowIndex=0;
	//var lastRow =grid.object.rowCount();
	
	var filters = criteria.split(",");
	var required = filters[0].split("=");
	var input = filters[1].split("=");
	var length = filters[2].split("=");
	
	//while(rowIndex<lastRow) {
		//required
		
		if(trim(required[1])=="true" ) {
			if (trim(grid.object.getCellText(rowIndex, columnIndex)) == "") {
				//alert("Input required for "+ cellName +" at row: "+ ++rowIndex);
				ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Input Required");
				return false;
			}
		}
		
		if(trim(grid.object.getCellText(rowIndex, columnIndex))!= "") {
			//type
			//if(trim(input[1])=="allowAll") {
			//	return true;
			//}
			if(trim(input[1])=="decimal") {
				if (!isDecimal(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric or decimal values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only numeric or decimal values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="gridText") {
				if (!isValidTextForGrid(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Only alpha-Numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only alpha-Numeric values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="number") {
				if (!isNumberValid(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only integer values are allowed (No Decimal)");
					return false;
				}
			}
			else if(trim(input[1])=="date") {
				if (!isValidDateWithFormat(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Date is not valid for "+ cellName +" at row: "+ ++rowIndex +" \nDate Format is DD/MM/YYYY");
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Date is not valid. \nDate Format is DD/MM/YYYY");
					return false;
				}
			}
			
			else if(trim(input[1])=="NICNEW") {
				if (!isValidNIC(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Date is not valid for "+ cellName +" at row: "+ ++rowIndex +" \nDate Format is DD/MM/YYYY");
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Invalid NIC No. of Investor. CNIC Format should be(#####-#######-#)");
					return false;
				}
			}
			
				else if(trim(input[1])=="NICOLD") {
				if (!isNumberValid(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Invalid NIC No. of Investor. CNIC Format should be(###########)");
					return false;
				}
				if (grid.object.getCellText(rowIndex, columnIndex).length > 11 ||grid.object.getCellText(rowIndex, columnIndex).length < 11) {
			
				ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Invalid NIC No. of Investor. CNIC Format should be(###########)");
					return false;
				}
			}
			
			//if decimal or number value, remove comma(,) and then check length
			if(trim(input[1])=="decimal" || trim(input[1])=="number") {
				//length
				if (grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,"").length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
			else {
				//length
				if (grid.object.getCellText(rowIndex, columnIndex).length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
		}
		//rowIndex++;
	//}
	return true;
}

function isValidNIC(NIC) {


	var matchArr = NIC.match(/^(\d{5})-\d{7}-\d{1}$/);
	var numDashes = NIC.split('-').length - 1;
	if (matchArr == null || numDashes == 1) {
		return false;
	}
	return true;
}



function validateGridCellMultiple(grid, columnIndex, criteria, cellName,gridName) {
	var rowIndex=0;
	var lastRow =grid.object.rowCount();
	
	var filters = criteria.split(",");
	var required = filters[0].split("=");
	var input = filters[1].split("=");
	var length = filters[2].split("=");
	
	while(rowIndex<lastRow) {
		//required
		
		if(trim(required[1])=="true") {
			if (trim(grid.object.getCellText(rowIndex, columnIndex)) == "") {
				//alert("Input required for "+ cellName +" at row: "+ ++rowIndex + " for " + gridName);
				ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Input Required");
				return false;
			}
		}
		
		if(trim(grid.object.getCellText(rowIndex, columnIndex))!="") {
			//type
			//if(trim(input[1])=="allowAll") {
			//	return true;
			//}
			if(trim(input[1])=="decimal") {
				if (!isDecimal(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric or decimal values are allowed for "+ cellName +" at row: "+ ++rowIndex + " for " + gridName);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only numeric or decimal values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="gridText") {
				if (!isValidTextForGrid(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Only alpha-Numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex + " for " + gridName);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only alpha-Numeric values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="number") {
				if (!isNumberValid(grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,""))) {
					//alert("Only numeric values are allowed for "+ cellName +" at row: "+ ++rowIndex + " for " + gridName);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Only integer values are allowed (No Decimal)");
					return false;
				}
			}
			else if(trim(input[1])=="date") {
				if (!isValidDateWithFormat(grid.object.getCellText(rowIndex, columnIndex))) {
					//alert("Date is not valid for "+ cellName +" at row: "+ ++rowIndex +" \nDate Format is DD/MM/YYYY" + " for " + gridName);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Date is not valid \nDate Format is DD/MM/YYYY");
					return false;
				}
			}
			
			//if decimal or number value, remove comma(,) and then check length
			if(trim(input[1])=="decimal" || trim(input[1])=="number") {
				//length
				if (grid.object.getCellText(rowIndex, columnIndex).replace(/,/g,"").length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
			else {
				//length
				if (grid.object.getCellText(rowIndex, columnIndex).length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ ++rowIndex);
					ShowErrorOnGrid(grid, rowIndex, columnIndex, "Error", "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
		}
		rowIndex++;
	}
	return true;
}

function removeTrailingZeros(x) {
	var decPos=x.indexOf(".")
	if (decPos>-1)
	{
		first=x.substring(0,decPos);
		second=x.substring(decPos,x.length);
		while (second.charAt(second.length-1)=="0")
			second=second.substring(0,second.length-1);
		if (second.length>1)
			return first+second;
		else
			return first;
	}
	return x;
}//end of remTrailingZeros(x)


function GotoCell(GridObj, gRow, gColumn)
{

   var RowCount = GridObj.rowCount();
   var ColCount = GridObj.columnCount();

   if ((gColumn > ColCount) || (gRow > RowCount))
   {
      
   } else
   {
      GridObj.deactivateCell();   
      GridObj.activeCell = GridObj.getCellObject(gRow,gColumn);

      GridObj.activateCell();   
      GridObj.scroll();
      GridObj.position();

   }

   return false;
}


 function ShowErrorOnGrid(grid, row, col, title, body) {  
	
	grid.object.setFocus();
	
	GotoCell(grid.object, row, col);

    nitobi.callout.destroyLast();  
    // now we create a new one  
    var myCallout = new nitobi.callout.Callout("vista");  
    // we attach it to the element with ID myName  
    myCallout.attachToElement(grid.object.getCellObject(row,col).id);  
    myCallout.setTitle(title);  
    myCallout.setBody(body);  
    // now we show it.  
    myCallout.show();  
    //valueHistory[formField.id] = formField.value;  
    
}



