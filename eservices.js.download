// This function takes two dates in string and return true if second date is greater or equal and false otherwise
 function compareDates(firstDt, secondDt){

	var dateArray = firstDt.split("/");
	var firstDate=new Date();
	firstDate.setFullYear(dateArray[2],dateArray[1]-1,dateArray[0]);

	dateArray = secondDt.split("/");
	var secondDate =new Date();
	secondDate.setFullYear(dateArray[2],dateArray[1]-1,dateArray[0]);	

	if(secondDate >= firstDate){
		return true;
	}
		return false;
 
 }
 //Compare Dates
 function isequalDates(firstDt, secondDt){

	var dateArray = firstDt.split("/");
	var firstDate=new Date();
	firstDate.setFullYear(dateArray[2],dateArray[1]-1,dateArray[0]);

	dateArray = secondDt.split("/");
	var secondDate =new Date();
	secondDate.setFullYear(dateArray[2],dateArray[1]-1,dateArray[0]);	
	
	if(secondDate > firstDate){
		return false;
	}
	if(secondDate < firstDate)
	return false;
		return true;
 
 }
 
