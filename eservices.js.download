function isValidEmailAddress(inputValue)
{
	var Val=inputValue;
	var uslastindex;
	var atcount = 0;
	// alert("entry");
	if(inputValue.length > 50){
		alert('Email length should be less than 50 Characters');
		return false;
	}
	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);
		if(ch == '@'){
			atcount++;
			if(atcount > 1){
				alert("More than one @ in email address are not valid");
				return false;
			}
		}
		if(ch == '_')
			uslastindex = j;
		if( !((ch>='0' && ch<='9')||(ch>='a' && ch<='z') || (ch=='@') || (ch == '.' ) || (ch == '_' ) ||(ch == '-' ) ))
		{
			// alert("Invalid Chars")
			return false;
		}
		if((ch=='@') || (ch=='.')){
			if ((j+1) <= (Val.length-1)){
			ch = Val.charAt((j+1));
				if( !((ch>='0' && ch<='9') || (ch>='a' && ch<='z')))
				{
					// alert("WRONG VALUE");
					return false;
				}
			}else {
				// alert("at the end")
				return false;
			}
		}
	}
	
	if(uslastindex > inputValue.indexOf('@')){
		return false;
	} 

	return true;
}
function isValidEmailAddressMnd(inputValue)
{
	var reg = /^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$/;
	   var address = inputValue.value;
	   if(reg.test(address) == false) {
	 
	      alert('Please enter valid Email Address');
	      inputValue.focus();
	      return false;
	   }
	   
	   return true;

} 

