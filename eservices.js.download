//mostly uses for name, city , etc
function isAlphabeticSpacesorDash(inputValue)
{
	// alert("I'm into the func: "+inputValue);
	var Val=inputValue;

	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);

		if( !(ch>=' ' || ch<='-' || (ch>='A' && ch<='Z') || (ch>='a' && ch<='z')))
		{
			return false;
		}
	}

	return true;
}
//will be used for phone no, fax etc
function isNumericSpacesorDash(inputValue)
{
	var Val=inputValue;

	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);

		if( !((ch>='0' && ch<='9') || (ch == '-' ) || (ch = ' ')))
		{
			return false;
		}
	}

	return true;
}
	

