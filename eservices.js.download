function TrimTo2DecimalValues(val) {
	return val.substring(0, val.indexOf(".")+3);
}

function validateGridCelldhtmlx(mygrid, columnIndex, rowIndex, criteria, cellName) {

	
	
	var filters = criteria.split(",");
	var required = filters[0].split("=");
	var input = filters[1].split("=");
	var length = filters[2].split("=");
		
	
		if(trim(required[1])=="true" ) {
	
			if (trim(mygrid.cells2(rowIndex, columnIndex).getValue()+'') == "") {
				
				//alert("Input required for "+ cellName +" at row: "+ rowIndex);
				ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Input Required");
	
				return false;
			}
		}
		
		if(trim(mygrid.cells2(rowIndex, columnIndex).getValue()+'')!= "") {
		
			if(trim(input[1])=="decimal") {
				if (!isDecimal(mygrid.cells2(rowIndex, columnIndex).getValue()+'')) {
					//alert("Only numeric or decimal values are allowed for "+ cellName +" at row: "+ rowIndex);
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Only numeric or decimal values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="gridText") {
				if (!isValidTextForGrid(mygrid.cells2(rowIndex, columnIndex).getValue()+'')) {
					//alert("Only alpha-Numeric values are allowed for "+ cellName +" at row: "+ rowIndex);
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Only alpha-Numeric values are allowed");
					return false;
				}
			}
			else if(trim(input[1])=="number") {
		
				if (!isNumberValid(mygrid.cells2(rowIndex, columnIndex).getValue()+'')) {
					//alert("Only numeric values are allowed for "+ cellName +" at row: "+ rowIndex);
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Only integer values are allowed (No Decimal)");
					return false;
				}
			}
			else if(trim(input[1])=="date") {
				if (!isValidDateWithFormat(mygrid.cells2(rowIndex, columnIndex).getValue()+'')) {
					//alert("Date is not valid for "+ cellName +" at row: "+ rowIndex +" \nDate Format is DD/MM/YYYY");
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Date is not valid. \nDate Format is DD/MM/YYYY");
					return false;
				}
			}
			else if(trim(input[1])=="percentage") {
				if (!isPercentage(mygrid.cells2(rowIndex, columnIndex).getValue()+'')) {
					//alert("Date is not valid for "+ cellName +" at row: "+ rowIndex +" \nDate Format is DD/MM/YYYY");
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Percentage should be between 0 and 100");
					return false;
				}
			}
			
			//if decimal or number value, remove comma(,) and then check length
			if(trim(input[1])=="decimal" || trim(input[1])=="number") {
				//length
				if ((mygrid.cells2(rowIndex, columnIndex).getValue()+'').length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ rowIndex);
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
			
			else if(trim(input[1])=="NICNEW") {
				if (!isValidNIC(mygrid.cells2(rowIndex, columnIndex).getValue()+'')) {
					
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Invalid NIC No. CNIC Format should be(#####-#######-#)");
					return false;
				}
			}
			
			else {
				//length
				if ((mygrid.cells2(rowIndex, columnIndex).getValue()+'').length > length[1]) {
					//alert("Length cannot be greater than "+ length[1] +" for "+ cellName +" at row: "+ rowIndex);
					ShowErrorOnGriddhtmlx(mygrid, rowIndex, columnIndex, cellName, "Length cannot be greater than "+ length[1]);
					return false;
				}
			}
		}

	return true;
}


 function ShowErrorOnGriddhtmlx(mygrid, row, col, title, body) {  
	
	mygrid.selectCell(row, col);
	
    nitobi.callout.destroyLast(); 
    
    // now we create a new one  
    var myCallout = new nitobi.callout.Callout("vista"); 
    
    // we attach it to the element with ID myName  
    //
    try {
    	myCallout.attachToElement(mygrid.cells2(row, col).cell.id);
    }
    catch(err) {
    	myCallout.attachToElement(mygrid.cells2(row, col).cell.uniqueID);
    }
    myCallout.setTitle(title);  
    myCallout.setBody(body);  
    // now we show it.  
    myCallout.show();  
   
    //valueHistory[formField.id] = formField.value;  
    
}
 
 
 
function isPercentage(value) {
	if(value != "") {
		if(parseFloat(value) > 0.00 && parseFloat(value) < 100.00) {
			return true;
		}
	}
	return false;
}
 

	function enableBankBranch()
	{
		var paMode=document.getElementById("cmbModeOfPayment").value;
		document.getElementById("mode").value = paMode;			
		
		if(paMode=="Select")
		{					
			document.getElementById("bankBranch").disabled = false;
			document.getElementById('bankBranchURL').style.visibility='hidden';	
			document.getElementById("visamaster").style.visibility='hidden';	
			document.getElementById("card_charges").style.visibility='hidden';	
			//document.getElementById("adc_charges").style.visibility='hidden';	
			document.getElementById("bankBranch").value='';
		}
		else if(paMode=="Bank Challan")
		{					
			document.getElementById("bankBranch").disabled = false;
			document.getElementById("visamaster").style.visibility='hidden';	
			document.getElementById("card_charges").style.visibility='hidden';	
			//document.getElementById("adc_charges").style.visibility='hidden';	
			document.getElementById('bankBranchURL').style.visibility='visible';	
			if(document.getElementById("bankBranch").value=='Credit Card' || document.getElementById("bankBranch").value=='ADC/ePayment')
				document.getElementById("bankBranch").value='';
			
			}
		else if(paMode=="ADC/ePayment")
		{					
			document.getElementById("bankBranch").disabled = false;
			document.getElementById("visamaster").style.visibility='hidden';	
			document.getElementById('bankBranchURL').style.visibility='hidden';	
			document.getElementById("bankBranch").value='ADC/ePayment';
			document.getElementById("card_charges").style.visibility='visible';
			document.getElementById("card_charges").innerHTML = "1Link collection chargers of Rs.25 will be applicable";
		}
		else
		{
			document.getElementById("bankBranch").disabled = false;
			document.getElementById('bankBranchURL').style.visibility='hidden';
			document.getElementById("bankBranch").value='Credit Card';
			document.getElementById("visamaster").style.visibility='visible';
			document.getElementById("card_charges").style.visibility='visible';
			document.getElementById("card_charges").innerHTML = "Collection charges 3.7% of total fee will be applicable";
			
		}
		
	}

function doCheck(e) {
	   
    var code;
      if (!e) var e = window.event; // some browsers don't pass e, so get it from the window
    if (e.keyCode) code = e.keyCode; // some browsers use e.keyCode
    else if (e.which) code = e.which;  // others use e.which
  
    if ( code == 46)
        return false;
}



