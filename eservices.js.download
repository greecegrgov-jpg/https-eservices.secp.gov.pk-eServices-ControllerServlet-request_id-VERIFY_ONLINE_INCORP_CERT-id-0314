//trim left spaces ' xyz  ' --> ' xyz'
function LTrim( value ) {
	
	var re = /\s*((\S+\s*)*)/;
	return value.replace(re, "$1");
	
}
//trim right spaces ' xyz  ' --> 'xyz  '
function RTrim( value ) {
	
	var re = /((\s*\S+)*)\s*/;
	return value.replace(re, "$1");
	
}

//trim spaces around ' xyz  ' --> 'xyz'
function trim( value ) {
	
	return LTrim(RTrim(value));
	
}

function replaceSequences(value)
{
	var finalStr="";
	
	for(var j=0; j<value.length; j++)
	{
	  var alphaa = value.charAt(j);
	  var hh = alphaa.charCodeAt(0);
			
	  if(hh==34){
	  		finalStr+="&#34";
	  }
	  else
	  {
	  		finalStr+=alphaa;
	  }
	}
	//alert(finalStr);
	return finalStr;
}

function submitNameSearch(){
	var shouldSubmit= true;
	var val= secpform.searchName.value;
	var isSearchOptionSelected = false;
	/*if(secpform.searchName.value == ""){
		alert("Please enter the company name to search.");
		shouldSubmit = false;
	}*/

	
	for (var i=0; i < document.secpform.searchOption.length; i++)
   	{
   		if (document.secpform.searchOption[i].checked)
      	{      		
			isSearchOptionSelected= true;
      	}
   	}
   	if(!isSearchOptionSelected){
	   	alert("Please select one of the search criteria!");
	   	shouldSubmit = false;
	}

	if( trim(val) == "" || trim(val).length < 2)
	{	
		alert("Please enter atleast 2 characters to perform search.");
		secpform.searchName.focus = true;
		return false;
	}	

	if(shouldSubmit){
		secpform.submit();
	}

	return shouldSubmit;

	
	
}

/**
 * DHTML date validation script. Courtesy of SmartWebby.com (http://www.smartwebby.com/dhtml/)
 */
// Declaring valid date character, minimum year and maximum year
var dtCh= "-";
var dtSl= "/";
var minYear=1900;
var maxYear=2100;

function isInteger(s){
    if(s.length == 0)
    	return false;
	var i;
    for (i = 0; i < s.length; i++){   
        // Check that current character is number.
        var c = s.charAt(i);
        if (((c < "0") || (c > "9"))) return false;
    }
    // All characters are numbers.
    return true;
}
function stripCharsInBag(s, bag){
	var i;
    var returnString = "";
    // Search through string's characters one by one.
    // If character is not in bag, append to returnString.
    for (i = 0; i < s.length; i++){   
        var c = s.charAt(i);
        if (bag.indexOf(c) == -1) returnString += c;
    }
    return returnString;
}

function daysInFebruary (year){
	// February has 29 days in any year evenly divisible by four,
    // EXCEPT for centurial years which are not also divisible by 400.
    return (((year % 4 == 0) && ( (!(year % 100 == 0)) || (year % 400 == 0))) ? 29 : 28 );
}
function DaysArray(n) {
	for (var i = 1; i <= n; i++) {
		this[i] = 31
		if (i==4 || i==6 || i==9 || i==11) {this[i] = 30}
		if (i==2) {this[i] = 29}
   } 
   return this
}
function isDateWithSlash(dtStr){
	

	dtStr=dtStr.value;  	
	var daysInMonth = DaysArray(12);
	var pos1=dtStr.indexOf(dtSl);
	
	var pos2=dtStr.indexOf(dtSl,pos1+1);
	var strDay=dtStr.substring(0,pos1);
	var strMonth=dtStr.substring(pos1+1,pos2);
	var strYear=dtStr.substring(pos2+1);
	var date=new Date();
	var dateArray = dtStr.split("/");
	strYr=strYear;
	if (strDay.charAt(0)=="0" && strDay.length>1) strDay=strDay.substring(1);
	if (strMonth.charAt(0)=="0" && strMonth.length>1) strMonth=strMonth.substring(1);
	for (var i = 1; i <= 3; i++) {
		if (strYr.charAt(0)=="0" && strYr.length>1) strYr=strYr.substring(1);
	}

	month=parseInt(strMonth);
	day=parseInt(strDay);
	year=parseInt(strYr);
	
	
	 if(!/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(dtStr))
    {  
     alert("Invalid date value, the date format should be : DD/MM/YYYY") ;
     return false;
     }
	
	
	 date.setFullYear(dateArray[2],dateArray[1]-1,dateArray[0]);
	 var currentDate=new Date(); 

	    if(date > currentDate) 
	    {           
	       alert("Invalid Date(Date is greater than current date)");
	       return false; 
	    }  
	
	if (pos1==-1 || pos2==-1){
		alert("The date format should be : DD/MM/YYYY");
		return false;
	}
	if (strMonth.length<1 || month<1 || month>12){
		alert("Please enter a valid month");
		return false;
	}
	if (strDay.length<1 || day<1 || day>31 || (month==2 && day>daysInFebruary(year)) || day > daysInMonth[month]){
		alert("Please enter a valid day");
		return false;
	}
	if (strYear.length != 4 || year==0 || year<minYear || year>maxYear){
		alert("Please enter a valid 4 digit year between "+minYear+" and "+maxYear);
		return false;
	}
	if (dtStr.indexOf(dtSl,pos2+1)!=-1 || isInteger(stripCharsInBag(dtStr, dtSl))==false){
		alert("Please enter a valid date");
		return false;
	}
return true
}
function isDate(dtStr){

	var daysInMonth = DaysArray(12)
	var pos1=dtStr.indexOf(dtCh)
	var pos2=dtStr.indexOf(dtCh,pos1+1)
	var strDay=dtStr.substring(0,pos1)
	var strMonth=dtStr.substring(pos1+1,pos2)
	var strYear=dtStr.substring(pos2+1)
	strYr=strYear
	if(strDay.length==1){ 
	alert("The date format should be : DD-MM-YYYY e.d 01-01-2007")
	return false;
	}
	if(strMonth.length==1){ 
	alert("The date format should be : DD-MM-YYYY e.d 01-01-2007")
	return false;
	}
	
	if (strDay.charAt(0)=="0" && strDay.length>1) strDay=strDay.substring(1)
	if (strMonth.charAt(0)=="0" && strMonth.length>1) strMonth=strMonth.substring(1)
	for (var i = 1; i <= 3; i++) {
		if (strYr.charAt(0)=="0" && strYr.length>1) strYr=strYr.substring(1)
	}
	month=parseInt(strMonth)
	day=parseInt(strDay)
	year=parseInt(strYr)
	if (pos1==-1 || pos2==-1){
		alert("The date format should be : DD-MM-YYYY")
		return false
	}
	if (strMonth.length<1 || month<1 || month>12){
		alert("Please enter a valid month")
		return false
	}
	if (strDay.length<1 || day<1 || day>31 || (month==2 && day>daysInFebruary(year)) || day > daysInMonth[month]){
		alert("Please enter a valid day")
		return false
	}
	if (strYear.length != 4 || year==0 || year<minYear || year>maxYear){
		alert("Please enter a valid 4 digit year between "+minYear+" and "+maxYear)
		return false
	}
	if (dtStr.indexOf(dtCh,pos2+1)!=-1 || isInteger(stripCharsInBag(dtStr, dtCh))==false){
		alert("Please enter a valid date")
		return false
	}
return true
}
function isDateOK(dtStr, rowIndex){

	var daysInMonth = DaysArray(12);
	var pos1=dtStr.indexOf(dtSl);
	var pos2=dtStr.indexOf(dtSl,pos1+1);
	var strDay=dtStr.substring(0,pos1);
	var strMonth=dtStr.substring(pos1+1,pos2);
	var strYear=dtStr.substring(pos2+1);
	strYr=strYear;
	
	//alert('dtStr = ' + dtStr);
	//alert('rowIndex = ' + rowIndex);
	
	if (strDay.charAt(0)=="0" && strDay.length>1) strDay=strDay.substring(1);
	if (strMonth.charAt(0)=="0" && strMonth.length>1) strMonth=strMonth.substring(1);
	for (var i = 1; i <= 3; i++) {
		if (strYr.charAt(0)=="0" && strYr.length>1) strYr=strYr.substring(1);
	}

	if (pos1==-1 || pos2==-1)
	{
		alert("The date format should be : DD/MM/YYYY. Check row = " + rowIndex);
		return false;
	}

	//alert('strDay = ' + strDay);
	//alert('strMonth = ' + strMonth);
	//alert('strYear = ' + strYear);

	if(strDay.length == 1)
	{ 
		if(!(strDay.charAt(0) == '0' || strDay.charAt(0) == '1' || strDay.charAt(0) == '2' || strDay.charAt(0) == '3' || strDay.charAt(0) == '4'
		|| strDay.charAt(0) == '5' || strDay.charAt(0) == '6' || strDay.charAt(0) == '7' || strDay.charAt(0) == '8' || strDay.charAt(0) == '9'))
		{	
			alert("Invalid Day. Check row = " + rowIndex);
			return false;
		}		
	}
	if(strDay.length == 2)
	{
		//alert(strDay.charAt(0));
		//alert(strDay.charAt(1));
		if(!(strDay.charAt(0) == '0' || strDay.charAt(0) == '1' || strDay.charAt(0) == '2' || strDay.charAt(0) == '3' || strDay.charAt(0) == '4'
		|| strDay.charAt(0) == '5' || strDay.charAt(0) == '6' || strDay.charAt(0) == '7' || strDay.charAt(0) == '8' || strDay.charAt(0) == '9'))
		{	
			alert("Invalid Day. Check row = " + rowIndex);
			return false;
		}
		if(!(strDay.charAt(1) == '0' || strDay.charAt(1) == '1' || strDay.charAt(1) == '2' || strDay.charAt(1) == '3' || strDay.charAt(1) == '4'
		|| strDay.charAt(1) == '5' || strDay.charAt(1) == '6' || strDay.charAt(1) == '7' || strDay.charAt(1) == '8' || strDay.charAt(1) == '9'))
		{	
			alert("Invalid Day. Check row = " + rowIndex);
			return false;
		}
	}
	if(strDay.length<1 || strDay.length>2)
	{
		alert("Invalid Day. Check row = " + rowIndex);
		return false;
	}
	
	if(strMonth.length == 1)
	{ 
		if(!(strMonth.charAt(0) == '0' || strMonth.charAt(0) == '1' || strMonth.charAt(0) == '2' || strMonth.charAt(0) == '3' || strMonth.charAt(0) == '4'
			|| strMonth.charAt(0) == '5' || strMonth.charAt(0) == '6' || strMonth.charAt(0) == '7' || strMonth.charAt(0) == '8' || strMonth.charAt(0) == '9'))
		{	
			alert("Invalid Month. Check row = " + rowIndex);
			return false;
		}	
	}
	if(strMonth.length == 2)
	{
		if(!(strMonth.charAt(0) == '0' || strMonth.charAt(0) == '1' || strMonth.charAt(0) == '2' || strMonth.charAt(0) == '3' || strMonth.charAt(0) == '4'
		|| strMonth.charAt(0) == '5' || strMonth.charAt(0) == '6' || strMonth.charAt(0) == '7' || strMonth.charAt(0) == '8' || strMonth.charAt(0) == '9'))
		{
			alert("Invalid Month. Check row = " + rowIndex);
			return false;
		}
		if(!(strMonth.charAt(1) == '0' || strMonth.charAt(1) == '1' || strMonth.charAt(1) == '2' || strMonth.charAt(1) == '3' || strMonth.charAt(1) == '4'
		|| strMonth.charAt(1) == '5' || strMonth.charAt(1) == '6' || strMonth.charAt(1) == '7' || strMonth.charAt(1) == '8' || strMonth.charAt(1) == '9'))
		{
			alert("Invalid Month. Check row = " + rowIndex);
			return false;
		}	
	}
	if(strMonth.length<1 || strMonth.length>2)	
	{
		alert("Invalid Month. Check row = " + rowIndex);
		return false;
	}

	month=parseInt(strMonth);
	day=parseInt(strDay);
	year=parseInt(strYr);

	if (month<1 || month>12){		
		alert("Invalid Month. Check row = " + rowIndex);
		return false;
	}
	if (day<1 || day>31 || (month==2 && day>daysInFebruary(year)) || day > daysInMonth[month]){
		alert("Invalid Day. Check row = " + rowIndex);
		return false;
	}
	if (strYear.length != 4 || year==0 || year<minYear || year>maxYear){
		alert("Please enter a valid 4 digit year between "+minYear+" and "+maxYear+". Check row = " + rowIndex);
		return false;
	}
	//if (dtStr.indexOf(dtSl,pos2+1)!=-1 || isInteger(stripCharsInBag(dtStr, dtSl))==false){
		//alert("Please enter a valid date"+". Check row = " + rowIndex);
		//return false;
	//}
	return true;
}
function isValidNIC(NIC) {
	var matchArr = NIC.match(/^(\d{5})-\d{7}-\d{1}$/);
	var numDashes = NIC.split('-').length - 1;
	if (matchArr == null || numDashes == 1) {
		return false;
	}
	return true;
}	
