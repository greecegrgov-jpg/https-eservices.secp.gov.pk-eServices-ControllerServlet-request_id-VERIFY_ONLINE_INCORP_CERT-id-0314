function isValid(Input_value)
{
	var Val = Input_value;
	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);
	  	
	  	if(ch=='\'' || ch=='"' ||ch=='$' ||ch=='<' ||ch=='>')
	  		return false;	
	}
	
	return true;
}


function isNameValid(inputValue)
{
	var Val=inputValue;

	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);

		if( !((ch>='0' && ch<='9') || (ch>='A' && ch<='Z') || (ch>='a' && ch<='z' )|| (ch == ' ') || (ch == '.')))
		{
			return false;
		}
	}

	return true;
}
function isNumberValid(inputValue)
{
	var Val=inputValue;

	for(var j=0; j<Val.length; j++)
	{
	  	var ch = Val.charAt(j);

		if( !((ch>='0' && ch<='9')) )
		{
			return false;
		}
	}

	return true;
}


function isFilled(inputValue) {
	
	//inputValue is an object
	var Val=inputValue.value;  	
	if(Val.length < 0 || Val=='' )
		{
			alert('Please enter relevant data in the field');
			inputValue.focus();
			return false;
		}


	return true;
}
